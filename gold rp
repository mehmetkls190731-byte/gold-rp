}

function saveMember(){

    const name =
        document.getElementById("memberName").value.trim();

    if(!name){

        alert("İsim yazmalısın.");

        return;

    }

    localStorage.setItem(
        "goldMemberName",
        name
    );

    alert("İsmin kaydedildi: " + name);

    closeMembers();

}


/* SEARCH-LIKE SAFETY */

function escapeHtml(text){

    return String(text)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");

}


