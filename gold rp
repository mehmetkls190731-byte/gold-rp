    localStorage.setItem(
        "goldGangs",
        JSON.stringify(gangs)
    );

    renderGangAdmin();

}


/* RENDER JUSTICE */

function renderJustice(){

    const container =
        document.getElementById("justiceContainer");

    const list =
        document.getElementById("justiceAdminList");

    container.innerHTML="";
    list.innerHTML="";

    justice.forEach((x,i)=>{

        const avatar =
            x.image ||
            "https://i.pravatar.cc/200?img=12";

        container.innerHTML += `
        <div class="staff">
            <img class="avatar" src="${avatar}">
            <h3>${escapeHtml(x.name)}</h3>
            <p>${escapeHtml(x.role)}</p>
        </div>
        `;

        list.innerHTML += `
        <div class="admin-row">
            <b>${escapeHtml(x.name)}</b>
            <button
            class="btn btn-light"
            onclick="deleteJustice(${i})">
            Sil
            </button>
        </div>
        `;

    });

}


/* DELETE JUSTICE */

function deleteJustice(i){

    justice.splice(i,1);

    localStorage.setItem(
        "goldJustice",
        JSON.stringify(justice)
    );

    renderJustice();

}


/* RENDER STAFF */

function renderStaff(){

    const container =
        document.getElementById("staffContainer");

    const list =
        document.getElementById("staffAdminList");

    container.innerHTML="";
    list.innerHTML="";

    staff.forEach((x,i)=>{

        const avatar =
            x.image ||
            "https://i.pravatar.cc/200?img=12";

        container.innerHTML += `
        <div class="staff">
            <img class="avatar" src="${avatar}">
            <h3>${escapeHtml(x.name)}</h3>
            <p>${escapeHtml(x.role)}</p>
        </div>
        `;

        list.innerHTML += `
        <div class="admin-row">
            <b>${escapeHtml(x.name)}</b>
            <button
            class="btn btn-light"
            onclick="deleteStaff(${i})">
            Sil
            </button>
        </div>
        `;

    });

}


/* DELETE STAFF */

function deleteStaff(i){

    staff.splice(i,1);

    localStorage.setItem(
        "goldStaff",
        JSON.stringify(staff)
    );

    renderStaff();

}


/* MEMBER */

