<script>

/* =========================
   GOLD RP SITE SYSTEM
========================= */

const ADMIN_USER = "mehmet";
const ADMIN_PASS = "1234";


/* ADMIN */

function openAdmin(){

    document.getElementById("adminPanel").style.display="block";

}

function closeAdmin(){

    document.getElementById("adminPanel").style.display="none";

}

function adminLogin(){

    const user =
        document.getElementById("adminUsername").value;

    const pass =
        document.getElementById("adminPassword").value;

    if(user === ADMIN_USER && pass === ADMIN_PASS){

        document.getElementById("loginArea").style.display="none";

        document.getElementById("adminArea").style.display="block";

        loadAdminData();

    }else{

        alert("Kullanıcı adı veya şifre yanlış!");

    }

}

function adminLogout(){

    document.getElementById("adminArea").style.display="none";

    document.getElementById("loginArea").style.display="block";

}


/* ADMIN TABS */

function showAdminTab(id){

    document
    .querySelectorAll(".admin-content")
    .forEach(x => x.classList.remove("active"));

    document
    .getElementById(id)
    .classList.add("active");

}


/* LOCAL DATA */

let announcements =
    JSON.parse(localStorage.getItem("goldAnnouncements") || "[]");

let news =
    JSON.parse(localStorage.getItem("goldNews") || "[]");

let gangs =
    JSON.parse(localStorage.getItem("goldGangs") || "[]");

let justice =
    JSON.parse(localStorage.getItem("goldJustice") || "[]");

let staff =
    JSON.parse(localStorage.getItem("goldStaff") || "[]");


/* ANNOUNCEMENT */

function addAnnouncement(){

    const title =
        document.getElementById("announcementTitle").value;

    const text =
        document.getElementById("announcementText").value;

    if(!title || !text){

        alert("Başlık ve içerik yazmalısın.");

        return;

    }

    announcements.push({
        title,
        text,
        date:new Date().toLocaleDateString("tr-TR")
    });

    localStorage.setItem(
        "goldAnnouncements",
        JSON.stringify(announcements)
    );

    document.getElementById("announcementTitle").value="";
    document.getElementById("announcementText").value="";

    renderAnnouncements();

}


/* NEWS */

function addNews(){

    const title =
        document.getElementById("newsTitle").value;

    const image =
        document.getElementById("newsImage").value;

    const text =
        document.getElementById("newsText").value;

    if(!title || !text){

        alert("Başlık ve haber metni gerekli.");

        return;

    }

    news.push({
        title,
        image,
        text
    });

    localStorage.setItem(
        "goldNews",
        JSON.stringify(news)
    );

    document.getElementById("newsTitle").value="";
    document.getElementById("newsImage").value="";
    document.getElementById("newsText").value="";

    renderNews();

}


/* GANG */

function addGang(){

    const name =
        document.getElementById("gangName").value;

    const image =
        document.getElementById("gangImage").value;

    const text =
        document.getElementById("gangText").value;

    if(!name){

        alert("Çete adı yazmalısın.");

        return;

    }

    gangs.push({
        name,
        image,
        text
    });

    localStorage.setItem(
        "goldGangs",
        JSON.stringify(gangs)
    );

    document.getElementById("gangName").value="";
    document.getElementById("gangImage").value="";
    document.getElementById("gangText").value="";

    renderGangAdmin();

}


/* JUSTICE */

function addJustice(){

    const name =
        document.getElementById("justiceName").value;

    const role =
        document.getElementById("justiceRole").value;

    const image =
        document.getElementById("justiceImage").value;

    if(!name || !role){

        alert("İsim ve görev gerekli.");

        return;

    }

    justice.push({
        name,
        role,
        image
    });

    localStorage.setItem(
        "goldJustice",
        JSON.stringify(justice)
    );

    document.getElementById("justiceName").value="";
    document.getElementById("justiceRole").value="";
    document.getElementById("justiceImage").value="";

    renderJustice();

}


/* STAFF */

function addStaff(){

    const name =
        document.getElementById("staffName").value;

    const role =
        document.getElementById("staffRole").value;

    const image =
        document.getElementById("staffImage").value;

    if(!name || !role){

        alert("İsim ve görev gerekli.");

        return;

    }

    staff.push({
        name,
        role,
        image
    });

    localStorage.setItem(
        "goldStaff",
        JSON.stringify(staff)
    );

    document.getElementById("staffName").value="";
    document.getElementById("staffRole").value="";
    document.getElementById("staffImage").value="";

    renderStaff();

}


/* RENDER ANNOUNCEMENTS */

function renderAnnouncements(){

    const list =
        document.getElementById("announcementList");

    list.innerHTML="";

    announcements.forEach((x,i)=>{

        const row=document.createElement("div");

        row.className="admin-row";

        row.innerHTML=`
        <div>
            <b>${escapeHtml(x.title)}</b>
            <div style="font-size:12px;color:#777">
                ${escapeHtml(x.date)}
            </div>
        </div>

        <button
        class="btn btn-light"
        onclick="deleteAnnouncement(${i})">
        Sil
        </button>
        `;

        list.appendChild(row);

    });

}


/* DELETE ANNOUNCEMENT */

function deleteAnnouncement(i){

    announcements.splice(i,1);

    localStorage.setItem(
        "goldAnnouncements",
        JSON.stringify(announcements)
    );

    renderAnnouncements();

}


/* RENDER NEWS */

function renderNews(){

    const list =
        document.getElementById("newsAdminList");

    list.innerHTML="";

    news.forEach((x,i)=>{

        const row=document.createElement("div");

        row.className="admin-row";

        row.innerHTML=`
        <div>
            <b>${escapeHtml(x.title)}</b>
        </div>

        <button
        class="btn btn-light"
        onclick="deleteNews(${i})">
        Sil
        </button>
        `;

        list.appendChild(row);

    });

}


/* DELETE NEWS */

function deleteNews(i){

    news.splice(i,1);

    localStorage.setItem(
        "goldNews",
        JSON.stringify(news)
    );

    renderNews();

}


/* RENDER GANG ADMIN */

function renderGangAdmin(){

    const list =
        document.getElementById("gangAdminList");

    list.innerHTML="";

    gangs.forEach((x,i)=>{

        const row=document.createElement("div");

        row.className="admin-row";

        row.innerHTML=`
        <b>${escapeHtml(x.name)}</b>

        <button
        class="btn btn-light"
        onclick="deleteGang(${i})">
