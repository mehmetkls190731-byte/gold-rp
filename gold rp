index.html<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GOLD RP | Emergency Hamburg Roleplay</title>

<meta name="description" content="GOLD RP - Emergency Hamburg Roleplay">

<style>
:root{
    --gold:#d4a72c;
    --gold2:#f4c84b;
    --gold3:#ffe39a;
    --cream:#fffaf0;
    --white:#ffffff;
    --dark:#17130b;
    --brown:#4a3815;
    --gray:#746d60;
    --border:#ead9a7;
    --shadow:0 12px 35px rgba(94,68,12,.12);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:
        radial-gradient(circle at top right,#fff1b8 0,transparent 28%),
        linear-gradient(180deg,#fffdf7,#fff7df);
    color:var(--dark);
}

a{
    text-decoration:none;
    color:inherit;
}

button{
    font-family:inherit;
    cursor:pointer;
}

.container{
    width:min(1180px,92%);
    margin:auto;
}

/* NAVBAR */

.navbar{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(255,250,240,.94);
    backdrop-filter:blur(15px);
    border-bottom:1px solid var(--border);
}

.nav{
    height:76px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    font-weight:900;
    font-size:23px;
}

.logo-icon{
    width:43px;
    height:43px;
    border-radius:13px;
    display:grid;
    place-items:center;
    background:linear-gradient(135deg,var(--gold2),var(--gold));
    color:#fff;
    box-shadow:0 8px 20px rgba(212,167,44,.25);
}

.logo span{
    color:var(--gold);
}

.nav-links{
    display:flex;
    align-items:center;
    gap:22px;
    font-size:14px;
    font-weight:700;
}

.nav-links a{
    color:#5b503d;
    transition:.2s;
}

.nav-links a:hover{
    color:var(--gold);
}

.nav-buttons{
    display:flex;
    gap:8px;
}

.btn{
    border:0;
    padding:11px 17px;
    border-radius:12px;
    font-weight:800;
    transition:.2s;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-gold{
    color:#fff;
    background:linear-gradient(135deg,var(--gold2),var(--gold));
    box-shadow:0 8px 20px rgba(212,167,44,.2);
}

.btn-light{
    background:#fff;
    color:var(--brown);
    border:1px solid var(--border);
}

/* HERO */

.hero{
    padding:90px 0 70px;
}

.hero-grid{
    display:grid;
    grid-template-columns:1.15fr .85fr;
    gap:45px;
    align-items:center;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 13px;
    border-radius:999px;
    background:#fff5d3;
    border:1px solid #efd78d;
    color:#806116;
    font-size:13px;
    font-weight:800;
    margin-bottom:20px;
}

.hero h1{
    font-size:clamp(45px,7vw,82px);
    line-height:.95;
    letter-spacing:-4px;
    margin-bottom:24px;
}

.hero h1 span{
    color:var(--gold);
}

.hero p{
    color:var(--gray);
    line-height:1.8;
    font-size:17px;
    max-width:650px;
}

.hero-buttons{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:30px;
}

.hero-card{
    background:#fff;
    border:1px solid var(--border);
    border-radius:30px;
    padding:32px;
    box-shadow:var(--shadow);
    position:relative;
    overflow:hidden;
}

.hero-card::before{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    background:#ffe69b;
    border-radius:50%;
    right:-70px;
    top:-70px;
}

.hero-emblem{
    width:130px;
    height:130px;
    border-radius:35px;
    margin:auto;
    display:grid;
    place-items:center;
    font-size:60px;
    background:linear-gradient(135deg,#ffe17d,#c99513);
    color:#fff;
    box-shadow:0 20px 40px rgba(175,127,10,.22);
    position:relative;
}

.hero-card h3{
    text-align:center;
    margin-top:25px;
    font-size:25px;
}

.hero-card p{
    text-align:center;
    margin-top:8px;
    font-size:14px;
}

/* QUICK */

.quick{
    padding:0 0 35px;
}

.quick-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
}

.quick-item{
    background:#fff;
    border:1px solid var(--border);
    padding:21px;
    border-radius:18px;
    box-shadow:0 8px 25px rgba(94,68,12,.06);
}

.quick-item strong{
    display:block;
    font-size:20px;
    margin-bottom:5px;
}

.quick-item span{
    color:var(--gray);
    font-size:13px;
}

/* SECTIONS */

section{
    padding:80px 0;
}

.section-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:20px;
    margin-bottom:30px;
}

.section-head h2{
    font-size:38px;
    letter-spacing:-1px;
}

.section-head p{
    color:var(--gray);
    max-width:600px;
    line-height:1.6;
}

.gold-line{
    width:65px;
    height:5px;
    border-radius:20px;
    background:linear-gradient(90deg,var(--gold),var(--gold2));
    margin:12px 0 20px;
}

/* NEWS */

.news-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.card{
    background:#fff;
    border:1px solid var(--border);
    border-radius:22px;
    overflow:hidden;
    box-shadow:var(--shadow);
}

.card-image{
    width:100%;
    height:200px;
    object-fit:cover;
    background:linear-gradient(135deg,#f5d36b,#fff1bd);
}

.card-content{
    padding:22px;
}

.tag{
    display:inline-block;
    background:#fff3c9;
    color:#866516;
    border-radius:999px;
    padding:6px 10px;
    font-size:11px;
    font-weight:900;
    margin-bottom:12px;
}

.card h3{
    margin-bottom:9px;
    font-size:20px;
}

.card p{
    color:var(--gray);
    line-height:1.65;
    font-size:14px;
}

/* STAFF */

.staff-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.staff{
    text-align:center;
    background:#fff;
    border:1px solid var(--border);
    border-radius:22px;
    padding:25px 18px;
    box-shadow:var(--shadow);
}

.avatar{
    width:95px;
    height:95px;
    border-radius:50%;
    object-fit:cover;
    margin-bottom:15px;
    border:4px solid #f4d77b;
    background:#fff4cb;
}

.staff h3{
    font-size:18px;
}

.staff p{
    color:var(--gold);
    font-size:13px;
    font-weight:800;
    margin-top:5px;
}

/* GANGS */

.gang-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.gang{
    position:relative;
    overflow:hidden;
    border-radius:25px;
    min-height:390px;
    background:#17130b;
    color:#fff;
    border:1px solid #c99b26;
}

.gang img{
    width:100%;
    height:210px;
    object-fit:cover;
    opacity:.88;
}

.gang-body{
    padding:23px;
}

.gang h3{
    color:#f5cc4c;
    font-size:24px;
    margin-bottom:10px;
}

.gang p{
    color:#eee;
    line-height:1.6;
    font-size:14px;
}

.gang-btn{
    margin-top:18px;
}

/* JOIN */

.join-box{
    background:linear-gradient(135deg,#fff0b5,#fffdf5);
    border:1px solid #e9cf73;
    border-radius:28px;
    padding:40px;
    display:grid;
    grid-template-columns:1fr auto;
    gap:25px;
    align-items:center;
}

.join-box h3{
    font-size:30px;
    margin-bottom:10px;
}

.join-box p{
    color:#6f634b;
    line-height:1.7;
}

/* JUSTICE */

.justice{
    background:#fff;
    border-top:1px solid var(--border);
    border-bottom:1px solid var(--border);
}

.justice-top{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
    margin-bottom:30px;
}

.ministry{
    padding:35px;
    border-radius:25px;
    background:linear-gradient(135deg,#fff1b8,#fff);
    border:1px solid var(--border);
}

.ministry h3{
    font-size:28px;
    margin-bottom:10px;
}

.ministry p{
    color:var(--gray);
    line-height:1.7;
}

.justice-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

/* EVENTS */

.event-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.event{
    background:#fff;
    border:1px solid var(--border);
    border-radius:20px;
    padding:25px;
    box-shadow:var(--shadow);
}

.event-date{
    color:var(--gold);
    font-weight:900;
    font-size:13px;
    margin-bottom:9px;
}

/* APPLICATION */

.apply-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px;
}

.apply{
    background:#fff;
    border:1px solid var(--border);
    border-radius:20px;
    padding:24px;
    text-align:center;
}

.apply-icon{
    width:52px;
    height:52px;
    border-radius:15px;
    display:grid;
    place-items:center;
    margin:0 auto 15px;
    background:#fff1bd;
    font-size:24px;
}

.apply h3{
    margin-bottom:8px;
}

.apply p{
    color:var(--gray);
    font-size:13px;
    line-height:1.6;
}

/* SOCIAL */

.social-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.social{
    padding:28px;
    border-radius:22px;
    background:#fff;
    border:1px solid var(--border);
    box-shadow:var(--shadow);
}

.social strong{
    display:block;
    font-size:21px;
    margin-bottom:7px;
}

.social span{
    color:var(--gray);
}

/* FAQ */

.faq{
    max-width:850px;
    margin:auto;
}

details{
    background:#fff;
    border:1px solid var(--border);
    border-radius:16px;
    padding:18px 20px;
    margin-bottom:12px;
}

summary{
    font-weight:800;
    cursor:pointer;
}

details p{
    color:var(--gray);
    line-height:1.7;
    margin-top:13px;
}

/* FOOTER */

footer{
    background:#211a0d;
    color:#fff;
    padding:55px 0 25px;
}

.footer-grid{
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr;
    gap:35px;
}

footer h3{
    margin-bottom:13px;
    color:#f5ce53;
}

footer p,
footer a{
    color:#d8d0bd;
    line-height:1.8;
    font-size:14px;
}

.footer-bottom{
    margin-top:40px;
    padding-top:20px;
    border-top:1px solid rgba(255,255,255,.12);
    text-align:center;
    color:#aaa;
    font-size:13px;
}

/* ADMIN */

.admin-panel{
    display:none;
    position:fixed;
    inset:0;
    z-index:3000;
    background:rgba(25,19,7,.55);
    backdrop-filter:blur(8px);
    padding:30px;
    overflow:auto;
}

.admin-box{
    max-width:900px;
    margin:30px auto;
    background:#fffdf7;
    border-radius:25px;
    padding:30px;
    box-shadow:0 30px 90px rgba(0,0,0,.25);
}

.admin-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.admin-tabs{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:20px;
}

.admin-tab{
    border:1px solid var(--border);
    background:#fff;
    padding:10px 13px;
    border-radius:10px;
    font-weight:700;
}

.admin-content{
    display:none;
}

.admin-content.active{
    display:block;
}

.input{
    width:100%;
    padding:13px 14px;
    border-radius:11px;
    border:1px solid #dfd2b0;
    outline:none;
    margin-bottom:12px;
    font-family:inherit;
}

textarea.input{
    min-height:120px;
    resize:vertical;
}

.admin-note{
    background:#fff4c8;
    border:1px solid #efd47b;
    padding:14px;
    border-radius:12px;
    color:#6f5817;
    font-size:13px;
    margin-bottom:15px;
}

.admin-list{
    margin-top:20px;
}

.admin-row{
    display:flex;
    justify-content:space-between;
    gap:15px;
    align-items:center;
    background:#fff;
    border:1px solid var(--border);
    border-radius:13px;
    padding:14px;
    margin-bottom:8px;
}

/* MEMBER */

.member-modal{
    display:none;
    position:fixed;
    inset:0;
    z-index:2500;
    background:rgba(20,15,5,.45);
    backdrop-filter:blur(7px);
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal-box{
    background:#fff;
    border-radius:23px;
    padding:30px;
    width:min(450px,100%);
    box-shadow:0 30px 80px rgba(0,0,0,.25);
}

.modal-box h2{
    margin-bottom:10px;
}

.modal-box p{
    color:var(--gray);
    margin-bottom:20px;
    line-height:1.6;
}

/* SEARCH */

.search{
    display:flex;
    gap:10px;
}

.search input{
    flex:1;
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:12px;
}

/* RESPONSIVE */

@media(max-width:950px){
    .nav-links{
        display:none;
    }

    .hero-grid,
    .justice-top,
    .join-box{
        grid-template-columns:1fr;
    }

    .quick-grid,
    .staff-grid,
    .justice-grid,
    .apply-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .news-grid,
    .gang-grid,
    .event-grid,
    .social-grid{
        grid-template-columns:1fr;
    }

    .footer-grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:600px){
    .hero{
        padding:60px 0 40px;
    }

    .hero h1{
        font-size:50px;
    }

    .quick-grid,
    .staff-grid,
    .justice-grid,
    .apply-grid{
        grid-template-columns:1fr;
    }

    section{
        padding:55px 0;
    }

    .section-head{
        display:block;
    }

    .section-head h2{
        font-size:30px;
    }

    .admin-panel{
        padding:10px;
    }

    .admin-box{
        margin:5px auto;
        padding:20px;
    }
}
</style>
</head>

